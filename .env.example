
# TASK-AI-08 — AI API (catspeak-ai), noi tro ly chatbot goi toi.
# Local chay bang devops_ai thi la http://127.0.0.1:8080.
# Khi gateway .NET san sang thi doi sang duong dan cua gateway va bo CORS ben AI API.
VITE_AI_API_BASE_URL=http://127.0.0.1:8080

# CHI DUNG KHI PHAT TRIEN. Cho mo widget chatbot khi chua dang nhap, de thu giao dien
# ma khong phai chay catspeak-api tai may. Phai di kem AI_API_ALLOW_ANONYMOUS=1 ben
# AI API. O che do nay account_id la null nen quota khong dem duoc.
VITE_AI_ALLOW_ANONYMOUS=0
